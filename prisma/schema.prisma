generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// `role` and `category` are plain strings. Allowed values live in src/lib/constants.ts
// and are validated with zod in the API, so the UI and API share one list.

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime @default(now())

  favourites  FavouriteCategory[]
  reminders   Reminder[]
  cardDesigns CardDesign[]
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String // Music | Workshop | Food | Sports | Kids
  city        String
  startsAt    DateTime // stored in UTC, shown in IST
  price       Int // whole rupees, 0 = free
  description String
  imageUrl    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reminders   Reminder[]
  cardDesigns CardDesign[]

  // Public listing: { isActive: true, startsAt: { $gte: now } } sorted by startsAt
  @@index([isActive, startsAt])
  // Category filter / My Feed: { category: { $in: [...] }, isActive, startsAt }
  @@index([category, isActive, startsAt])
}

model FavouriteCategory {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  category String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Reminder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  eventId   String   @db.ObjectId
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // One reminder per user per event; also makes "set reminder" an idempotent upsert.
  @@unique([userId, eventId])
}

model CardDesign {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  eventId   String   @db.ObjectId
  theme     String // one of CARD_THEMES ids
  stickers  String[] // sticker ids, max 3, e.g. ["star", "party"]
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}
