# MongoDB connection string. The database name (community_events) must be in the path.
# A free MongoDB Atlas cluster works; Prisma needs a replica set, which Atlas always is.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/community_events?retryWrites=true&w=majority"
# Any long random string. Used to sign JWTs.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# The single hard-coded admin, created by the seed script.
ADMIN_EMAIL="admin@events.local"
ADMIN_PASSWORD="Admin@123"
